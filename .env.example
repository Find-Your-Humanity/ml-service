# Default environment for ml-service container
# In Kubernetes, mount the PVC named ml-service-models to /root/ml-service-models
# and set MODEL_DIR accordingly.

MODEL_DIR=/root/ml-service-models
# Optional: where to look for sample data (not required at runtime)
DATA_DIR=/app/src/data/behavior_data

# Training hyperparameters (used by train_autoencoder.py if invoked)
EPOCHS=50
BATCH_SIZE=32
LR=1e-3
